# Required: token from @BotFather.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Required for Codex commands. Send /id to the bot to get your user id.
# Multiple users: 111111111,222222222
TELEGRAM_ALLOWED_USER_IDS=

# Optional Codex settings.
CODEX_BINARY=codex
CODEX_BACKEND=app-server
CODEX_WORKDIR=.
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL=never
CODEX_TIMEOUT_SECONDS=900
CODEX_SESSION_DB=codex_sessions.sqlite3
CODEX_SKIP_GIT_REPO_CHECK=1
CODEX_DANGEROUSLY_BYPASS=0
CODEX_EXTRA_ARGS=
MAX_CONCURRENT_CODEX_JOBS=1
LOG_LEVEL=INFO
